# Copy this file to .env before running Docker Compose.

# PostgreSQL credentials (replace the password for local use)
POSTGRES_USER=sentiment_app
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=sentiment_db

# Host ports
POSTGRES_HOST_PORT=5432
GATEWAY_HOST_PORT=8080

# Internal service addresses and ports
GATEWAY_CONTAINER_PORT=8080
WORKER_GRPC_PORT=50051
GRPC_WORKER_ADDRESS=worker:50051
DB_HOST=postgres
DB_PORT=5432

# Database connection options
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Tokyo

# Python worker
GRPC_BIND_ADDRESS=[::]
GRPC_MAX_WORKERS=10
MODEL_NAME=distilbert/distilbert-base-uncased-finetuned-sst-2-english
TORCH_VERSION=2.5.1
LOG_LEVEL=INFO
